# Copy to .env and adjust as needed (compose loads these automatically if present)

LOG_LEVEL=INFO
TTS_ENGINE=cosyvoice
DEVICE=cpu

# Bind addresses (API + static web UI)
HOST=0.0.0.0
PORT=27755
UI_PORT=27756
UI_ENABLED=true
# UI_ROOT=/app/web

# Hugging Face model id — download on first run into /models
# Fine-tuned CosyVoice2 Cantonese (WenetSpeech-Yue ZoengJyutGaai)
MODEL_NAME=ASLP-lab/Cosyvoice2-Yue-ZoengJyutGaai
# Optional override (same role as MODEL_NAME)
# COSYVOICE_MODEL=ASLP-lab/Cosyvoice2-Yue-ZoengJyutGaai
MODEL_LOCAL_NAME=Cosyvoice2-Yue-ZoengJyutGaai

DEFAULT_LANGUAGE=yue
DEFAULT_SPEAKER=default
OUTPUT_FORMAT=wav
MAX_CHARS_PER_CHUNK=200

DOWNLOAD_SOURCE=huggingface
# HF_TOKEN=hf_xxx

SKIP_MODEL_DOWNLOAD=false
# Low thread counts keep peak RSS smaller on 16GB Podman VMs
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
# Stream CosyVoice token2wav in hop windows (lower peak RSS for longer text)
COSYVOICE_STREAM=true
# Optional: smaller hop (default CosyVoice2 is 25) for tighter memory
# COSYVOICE_TOKEN_HOP_LEN=15
